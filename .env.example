# =================================================================
# Chat-AaaS Enterprise Environment Configuration Template
# =================================================================

# Server & Runtime Environment
ENVIRONMENT=production
DEBUG=false
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://chat-aaas.com

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chat_aaas

# Redis Cache & Background Queue
REDIS_URL=redis://localhost:6379/0

# Security, Cryptography & JWT
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
INTERNAL_SERVICE_TOKEN=
ENCRYPTION_KEY=

# LLM Providers (Multi-Model Support)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_WIDGET_URL=https://chat-aaas.com/widget