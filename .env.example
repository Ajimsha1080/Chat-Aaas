# ==========================================
# Chat-AaaS Production Environment Configuration
# ==========================================

# Server & Runtime
ENVIRONMENT=production
PORT=8000
CORS_ORIGINS=http://localhost:5173,https://your-domain.com

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://aaas_admin:secret_password@postgres:5432/aaas_production

# Redis Cache & Task Queue
REDIS_URL=redis://redis:6379/0

# Security Secrets (Generate using: openssl rand -hex 32)
JWT_SECRET=super-secret-jwt-key-for-tenant-sessions-change-in-prod
PYTHON_AI_INTERNAL_SECRET=secret-internal-key-change-in-prod

# AI LLM Provider Keys (at least one is required)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Payment & Billing (Optional)
STRIPE_SECRET_KEY=your_stripe_secret_key
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
