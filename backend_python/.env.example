# ==============================================================================
# CoarAI (Chat-AaaS) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your production secrets.

# ----------------- Core Server Settings -----------------
ENVIRONMENT=development
DEBUG=false
PORT=8000
SERVER_HOST=127.0.0.1

# ----------------- Database & Cache -----------------
# Async PostgreSQL connection string (asyncpg driver required)
DATABASE_URL=postgresql+asyncpg://aaas_admin:secret_password@localhost:5432/aaas_production
# Redis cache and queue connection
REDIS_URL=redis://localhost:6379/0

# ----------------- Authentication & Security -----------------
# Generate each with: openssl rand -hex 32
JWT_SECRET=<generate: openssl rand -hex 32>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Internal inter-service authentication secret
PYTHON_AI_INTERNAL_SECRET=<generate: openssl rand -hex 32>

# 64-character hex key for AES-256 encryption
ENCRYPTION_KEY=<generate: openssl rand -hex 32>

# CORS Whitelist (comma-separated HTTPS origins in production; no wildcard *)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ----------------- Data Seeding & Development -----------------
# Must be false in production. Set true only in local development to seed sample fixtures.
SEED_DEMO_DATA=false

# ----------------- Object Storage (AWS S3 / Cloudflare R2) -----------------
STORAGE_PROVIDER=local
S3_BUCKET_NAME=coarai-documents-prod
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# ----------------- Payment Gateway (Razorpay Subscriptions) -----------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ----------------- Transactional Email (Resend / AWS SES) -----------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="CoarAI Support <notifications@coarai.com>"

# ----------------- AI / LLM Provider Keys (Optional) -----------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SARVAM_API_KEY=

# Custom / In-House / Private LLM Endpoint (OpenAI-compatible)
CUSTOM_LLM_API_URL=https://api.sarvam.ai/v1/chat/completions
CUSTOM_LLM_API_KEY=
DEFAULT_LLM_MODEL=sarvam-2b

# ----------------- Frontend Build Variables -----------------
VITE_API_BASE_URL=
