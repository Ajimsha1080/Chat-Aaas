# ==============================================================================
# Chat-AaaS (Agent-as-a-Service) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your production secrets.

# ----------------- Core Server Settings -----------------
ENVIRONMENT=development
DEBUG=false
PORT=8000

# ----------------- Database & Cache -----------------
# Async PostgreSQL connection string (asyncpg driver required)
DATABASE_URL=postgresql+asyncpg://aaas_admin:secret_password@localhost:5432/aaas_production
# Redis cache and queue connection
REDIS_URL=redis://localhost:6379/0

# ----------------- Authentication & Security -----------------
# Generate with: openssl rand -hex 32
JWT_SECRET=super-secret-jwt-key-for-tenant-sessions-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Internal inter-service authentication secret
PYTHON_AI_INTERNAL_SECRET=secret-internal-key-change-in-prod

# 64-character hex key for AES-256-GCM encryption of sensitive tenant keys
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS Whitelist (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ----------------- Data Seeding & Development -----------------
# Set to true to populate sample tenants (TechFlow, UrbanCraft, FinScale) on startup
SEED_DEMO_DATA=true

# ----------------- AI / LLM Provider Keys (Optional) -----------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SARVAM_API_KEY=

# Custom / In-House / Private LLM Endpoint (OpenAI-compatible)
CUSTOM_LLM_API_URL=https://api.sarvam.ai/v1/chat/completions
CUSTOM_LLM_API_KEY=
DEFAULT_LLM_MODEL=sarvam-2b

# ----------------- Frontend Build Variables -----------------
VITE_API_BASE_URL=http://localhost:8001
